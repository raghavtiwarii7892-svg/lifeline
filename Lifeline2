   Paths: /login (public), and / , /timeline, /access (patients), /profile (doctors).
   Hosted over http(s) it uses real paths (needs the SPA fallback in _redirects / vercel.json);
   opened from a file it falls back to #/ paths. */
const PATHTAB={'/':'home','/timeline':'timeline','/access':'access','/profile':'profile'};
const TABPATH=Object.fromEntries(Object.entries(PATHTAB).map(([p,t])=>[t,p]));
const HASH=location.protocol==='file:';
const redirectTo=HASH?undefined:location.origin+'/login';
