<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Lifeline – medical records (Supabase)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{color-scheme:light;--bg:#fff;--surface:#f4f9fa;--ink:#12303d;--muted:#58707c;--line:#d9e6ea;--blue:#1f6fb2;--teal:#0d8f8a;--tealsoft:#e4f4f3;--bluesoft:#e8f1fa;--warn:#fff4d6;--warnink:#7a5200;--danger:#b3363f;--ok:#14794f;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 Figtree,system-ui,-apple-system,"Segoe UI",sans-serif}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:30}
h1,h2,h3{line-height:1.25;margin:0 0 .4em}h1{font-size:1.6rem}h2{font-size:1.2rem}h3{font-size:1rem}
p{margin:0 0 .6em}.muted{color:var(--muted);font-size:.9rem}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
.proto{background:var(--warn);color:var(--warnink);font-size:.85rem;padding:8px 16px;text-align:center}
header.top{display:flex;align-items:center;gap:16px;padding:12px 20px;border-bottom:1px solid var(--line);position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);z-index:20}
.brand{display:flex;align-items:center;gap:8px;font-weight:700;font-size:1.2rem;color:var(--blue)}
nav.tabs{display:flex;gap:4px;margin-left:auto}
nav.tabs button,.who button{background:none;border:0;padding:8px 14px;border-radius:8px;cursor:pointer;color:var(--muted);font-weight:500}
nav.tabs button.on{background:var(--bluesoft);color:var(--blue);font-weight:600}
.who{display:flex;align-items:center;gap:6px;font-size:.9rem;color:var(--muted)}
main{max-width:980px;margin:0 auto;padding:20px 16px 90px}
.card{border:1px solid var(--line);border-radius:14px;padding:18px;background:var(--bg);margin-bottom:16px}
.card.soft{background:var(--surface)}
.grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(210px,1fr))}
.row{display:flex;gap:12px;flex-wrap:wrap;align-items:center;justify-content:space-between}
.badge{display:inline-block;font-size:.78rem;font-weight:600;padding:2px 9px;border-radius:99px;background:var(--bluesoft);color:var(--blue)}
.badge.warn{background:var(--warn);color:var(--warnink)}.badge.ok{background:var(--tealsoft);color:var(--ok)}.badge.bad{background:#fde7e8;color:var(--danger)}
.btn{background:var(--blue);color:#fff;border:0;border-radius:10px;padding:10px 18px;font-weight:600;cursor:pointer;min-height:44px}
:root[data-theme="dark"] .btn,.btn.t{}
.btn.teal{background:var(--teal);color:#fff}.btn.ghost{background:none;color:var(--blue);border:1px solid var(--line)}.btn.danger{background:none;color:var(--danger);border:1px solid var(--danger)}
.btn:disabled{opacity:.5}
label{display:block;font-weight:600;font-size:.9rem;margin:12px 0 4px}
input,select,textarea{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);min-height:44px}
textarea{min-height:90px}
.auth{max-width:460px;margin:24px auto}
.seg{display:flex;background:var(--surface);border-radius:10px;padding:4px;margin-bottom:12px}
.seg button{flex:1;border:0;background:none;padding:9px;border-radius:8px;font-weight:600;color:var(--muted);cursor:pointer}
.seg button.on{background:var(--bg);color:var(--blue);box-shadow:0 0 0 1px var(--line)}
.stage{border:1px solid var(--line);border-radius:14px;padding:14px;opacity:.6}
.stage.cur{opacity:1;border-color:var(--teal);background:var(--tealsoft)}
.stage h3{display:flex;justify-content:space-between;gap:8px;align-items:center}
.kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}.kv b{display:block;font-size:.8rem;color:var(--muted);font-weight:500}
.tl{position:relative;margin:0;padding:0 0 0 22px;list-style:none;border-left:2px solid var(--line)}
.tl li{position:relative;margin-bottom:14px}
.tl li::before{content:"";position:absolute;left:-29px;top:18px;width:12px;height:12px;border-radius:50%;background:var(--teal);border:3px solid var(--bg)}
.tl li.sys::before{background:var(--blue)}
.rec{border:1px solid var(--line);border-radius:12px;padding:14px;background:var(--bg)}
.rec .meta{font-size:.82rem;color:var(--muted);margin-top:6px}
.exp{font-variant-numeric:tabular-nums;font-weight:700;color:var(--teal)}
.toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:10px;z-index:40;max-width:90vw}
.empty{text-align:center;padding:28px;color:var(--muted)}
@media (max-width:700px){
 header.top{padding:10px 14px}.who span{display:none}
 nav.tabs{position:fixed;left:0;right:0;bottom:0;margin:0;background:var(--bg);border-top:1px solid var(--line);padding:6px 6px calc(6px + env(safe-area-inset-bottom,0px));z-index:25;justify-content:space-around}
 nav.tabs button{flex:1;padding:10px 4px;font-size:.85rem}
 .who{margin-left:auto}h1{font-size:1.35rem}
}
@media (prefers-reduced-motion:no-preference){.toast{animation:pop .2s ease-out}@keyframes pop{from{opacity:0;transform:translate(-50%,8px)}}}
.av{position:relative;width:34px;height:34px;border-radius:50%;background:var(--bluesoft);color:var(--blue);display:grid;place-items:center;font-weight:700;font-size:.8rem;cursor:pointer;overflow:hidden;flex:none}.av img{width:100%;height:100%;object-fit:cover}.av input{position:absolute;opacity:0;inset:0;width:100%;height:100%;cursor:pointer}.av:focus-within{outline:3px solid var(--blue);outline-offset:2px}
</style>
</head>
<body>
<div class="proto">Prototype connected to Supabase · use fictional test data only · not security-reviewed</div>
<div id="app"></div>
<script type="module" src="/src/main.js"></script>

</body>
</html>
{
  "name": "lifeline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": { "dev": "vite", "build": "vite build", "preview": "vite preview" },
  "dependencies": { "@supabase/supabase-js": "^2.45.4" },
  "devDependencies": { "vite": "^5.4.11" }
}
import { defineConfig } from 'vite';
export default defineConfig({});
[build]
  command = "npm run build"
  publish = "dist"

[[redirects]]
  from = "/*"
  to = "/index.html"
  status = 200
 { "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }] }
import { createClient } from '@supabase/supabase-js';

/* ===== 1. DATA LAYER (Supabase) =====
   The Project URL and publishable key are safe in browser code: security comes from the
   Row Level Security rules in the database. NEVER put a service_role or secret key here.
   In a bundler project (Vite/Lovable) read these from import.meta.env.VITE_SUPABASE_URL
   and import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY instead of hard-coding them. */
/* Read from .env (VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY). The fallbacks are your project's
   public URL and publishable key, so the app still works if the env vars are not set on the host. */
const CONFIG={
 url:import.meta.env.VITE_SUPABASE_URL||'https://pglstessuhzhkhbemhwe.supabase.co',
 key:import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY||'sb_publishable_1ocZpFYy9EUcRQtbkBXyiQ__eSnY0_I'};
const sb=createClient(CONFIG.url,CONFIG.key);
const now=()=>Date.now(), ms=t=>t?new Date(t).getTime():null;
const db={patients:[],doctors:[],records:[],requests:[]}; /* cache of what the signed-in user may see */
const ST={pediatric:'Pediatrics',adult:'Adult',geriatric:'Geriatrics'};
const stageKey=a=>a<18?'pediatric':a<60?'adult':'geriatric';
const fail=e=>{if(e){console.error(e);throw e}};
const mapPatient=p=>({avatarUrl:p.avatar_url,uuid:p.id,id:p.patient_code,name:p.full_name,dob:p.date_of_birth,sex:p.sex,joinedAt:ms(p.joined_at),allergies:'',allergiesVerifiedBy:null,allergyIds:[]});
const mapDoctor=p=>({avatarUrl:p.avatar_url,id:p.id,name:p.full_name,quals:p.qualifications||'',regNo:p.registration_no||'',hospital:p.hospital||''});
const mapGrant=(g,code)=>({id:g.id,doctorId:g.doctor_id,patientId:code,minutes:g.minutes,status:g.status,requestedAt:ms(g.requested_at),expiresAt:ms(g.expires_at)});
const mapRec=(r,code)=>({id:r.id,patientId:code,section:r.obg_gynae?'OBG & Gynae':ST[r.stage],type:r.record_type,title:r.title,note:r.note,author:r.author_name||'Unknown',reg:r.author_reg||'',hospital:r.author_hospital||'',createdAt:ms(r.created_at),addendumTo:r.title.startsWith('Addendum: ')?r.title.slice(10):undefined});
const startRec=p=>({id:'start-'+p.id,patientId:p.id,section:'system',type:'Lifeline started',title:'Lifeline record started',note:'Your lifelong record begins today. Earlier history is not required.',author:'Lifeline',createdAt:p.joinedAt,system:true});
function applyAllergies(p,rows){p.allergyIds=rows.map(a=>a.id);p.allergies=rows.map(a=>a.description).join('; ');const v=rows.length&&rows.every(a=>a.verified_at);p.allergiesVerifiedBy=v?`${rows[0].verified_by_name||'a professional'} · ${fmtDate(rows[0].verified_at)}`:null}

const api={
 /* auth */
 async loadMe(){const{data:{session}}=await sb.auth.getSession();if(!session)return null;
  const{data,error}=await sb.from('profiles').select('*').eq('id',session.user.id).maybeSingle();fail(error);
  if(!data)return null;S.role=data.role;return data.role==='doctor'?mapDoctor(data):mapPatient(data)},
 async signIn(email,pw){const{error}=await sb.auth.signInWithPassword({email,password:pw});fail(error)},
 /* The profile row (name, role, date of birth...) is created by a database trigger from
    this sign-up metadata, so it also works when email confirmation is switched on. */
 async register(role,v){const meta=role==='doctor'?{role,full_name:v.name,qualifications:v.quals,registration_no:v.regNo,hospital:v.hospital}
   :{role,full_name:v.name,date_of_birth:v.dob,sex:v.sex,allergies:v.allergies||''};
  const{data,error}=await sb.auth.signUp({email:v.email,password:v.pw,options:{data:meta,emailRedirectTo:redirectTo}});fail(error);
  return data.session?'ok':'confirm'},
 signOut:()=>sb.auth.signOut(),
 /* load everything the signed-in user is allowed to see into the cache */
 async sync(){const me=S.user;if(!me)return;
  if(S.role==='patient'){
   const q=await Promise.all([sb.from('allergies').select('*').eq('patient_id',me.uuid),sb.from('medical_records').select('*').eq('patient_id',me.uuid),
    sb.from('access_grants').select('*').eq('patient_id',me.uuid),sb.from('profiles').select('*').eq('role','doctor')]);
   q.forEach(x=>fail(x.error));
   applyAllergies(me,q[0].data);db.patients=[me];db.doctors=q[3].data.map(mapDoctor);
   db.records=[startRec(me),...q[1].data.map(x=>mapRec(x,me.id))];db.requests=q[2].data.map(x=>mapGrant(x,me.id));
  }else{
   db.doctors=[me];db.patients=[];db.records=[];db.requests=[];
   if(!S.open)return;
   const f=await sb.rpc('find_patient',{code:S.open});fail(f.error);const row=f.data&&f.data[0];if(!row)return;
   const p={uuid:row.id,id:row.patient_code,name:row.full_name,dob:null,sex:null,joinedAt:null,allergies:'',allergiesVerifiedBy:null,allergyIds:[]};
   const g=await sb.from('access_grants').select('*').eq('doctor_id',me.id).eq('patient_id',p.uuid);fail(g.error);
   db.patients=[p];db.requests=g.data.map(x=>mapGrant(x,p.id));
   if(db.requests.some(x=>x.status==='approved'&&x.expiresAt>now())){
    const q=await Promise.all([sb.from('profiles').select('*').eq('id',p.uuid).single(),sb.from('allergies').select('*').eq('patient_id',p.uuid),sb.from('medical_records').select('*').eq('patient_id',p.uuid)]);
    q.forEach(x=>fail(x.error));Object.assign(p,mapPatient(q[0].data));applyAllergies(p,q[1].data);
    db.records=[startRec(p),...q[2].data.map(x=>mapRec(x,p.id))];
   }}},
 /* reads from the cache */
 findPatient:id=>db.patients.find(p=>p.id===String(id).trim().toUpperCase()),
 latestRequest(dId,pId){const r=db.requests.filter(r=>r.doctorId===dId&&r.patientId===pId).sort((a,b)=>b.requestedAt-a.requestedAt)[0];api.sweep(r);return r},
 sweep(r){if(r&&r.status==='approved'&&r.expiresAt<=now())r.status='expired';return r},
 hasAccess:(dId,pId)=>{const r=api.latestRequest(dId,pId);return !!r&&r.status==='approved'},
 requestsFor(pId){db.requests.forEach(api.sweep);return db.requests.filter(r=>r.patientId===pId).sort((a,b)=>b.requestedAt-a.requestedAt)},
 recordsFor:pId=>db.records.filter(r=>r.patientId===pId).sort((a,b)=>b.createdAt-a.createdAt),
 /* writes. Records are insert-only: there is deliberately no update or delete. */
 async requestAccess(dId,pId,minutes){const r=await sb.from('access_grants').insert({patient_id:api.findPatient(pId).uuid,minutes});fail(r.error)},
 async respond(id,ok){const r=await sb.rpc('respond_access',{grant_id:id,decision:ok?'approved':'denied'});fail(r.error)},
 async revoke(id){const r=await sb.rpc('respond_access',{grant_id:id,decision:'revoked'});fail(r.error)},
 async addRecord(dId,pId,f){const p=api.findPatient(pId),obg=f.section==='OBG & Gynae';
  const stage=obg?stageKey(ageOf(p.dob)):({Pediatrics:'pediatric',Adult:'adult',Geriatrics:'geriatric'})[f.section];
  const r=await sb.from('medical_records').insert({patient_id:p.uuid,stage,obg_gynae:obg,record_type:f.type,title:f.title,note:f.note});fail(r.error)},
 async confirmAllergies(dId,pId){for(const id of api.findPatient(pId).allergyIds){const r=await sb.rpc('verify_allergy',{allergy_id:id});fail(r.error)}}
};

/* ===== 2. HELPERS ===== */
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmtDate=t=>new Date(t).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});
const fmtDT=t=>fmtDate(t)+', '+new Date(t).toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});
const ageOf=dob=>{const b=new Date(dob),n=new Date();let a=n.getFullYear()-b.getFullYear();if(n<new Date(n.getFullYear(),b.getMonth(),b.getDate()))a--;return a};
const stageOf=a=>a<18?'Pediatrics':a<60?'Adult':'Geriatrics';
const obgOn=p=>p.sex==='Female'&&ageOf(p.dob)>=12;
const left=ms=>{const s=Math.max(0,Math.floor(ms/1e3)),h=Math.floor(s/3600),m=Math.floor(s%3600/60);return(h?h+'h ':'')+m+'m '+String(s%60).padStart(2,'0')+'s'};
const DUR=[[7,'7 minutes'],[60,'1 hour'],[720,'12 hours'],[1440,'24 hours']];
const durLabel=m=>(DUR.find(d=>d[0]===m)||[0,m+' min'])[1];
const SECTIONS={Pediatrics:'Birth to 17 years',Adult:'18 to 59 years','Geriatrics':'60 years and over','OBG & Gynae':'Obstetrics and gynaecology, where relevant'};

/* ===== 3. STATE + VIEWS ===== */
const S={user:null,role:'patient',mode:'login',tab:'home',open:null,toast:''};
const $app=document.getElementById('app');
const unverified=`<span class="badge warn" title="Entered by the patient">Unverified</span>`;

function authView(){
 const reg=S.mode==='register',doc=S.role==='doctor';
 return `<div class="auth"><div class="brand" style="font-size:1.6rem;margin-bottom:6px">${logo()} Lifeline</div>
 <p class="muted">One medical record, kept for life. Patients stay in control of who sees it.</p>
 <div class="card"><div class="seg" role="tablist"><button data-act="role" data-v="patient" class="${!doc?'on':''}">Patient</button><button data-act="role" data-v="doctor" class="${doc?'on':''}">Doctor</button></div>
 <h2>${reg?'Create your '+(doc?'doctor':'patient')+' account':'Sign in as '+(doc?'a doctor':'a patient')}</h2>
 <form data-form="auth">
 ${reg?`<label>Full name</label><input name="name" required autocomplete="name">`:''}
 ${reg&&!doc?`<label>Date of birth</label><input name="dob" type="date" required max="${new Date().toISOString().slice(0,10)}">
  <label>Sex</label><select name="sex"><option>Female</option><option>Male</option><option>Other</option></select>
  <label>Allergies (optional)</label><input name="allergies" placeholder="e.g. Penicillin"><p class="muted">Anything you enter is shown as unverified until a professional confirms it.</p>`:''}
 ${reg&&doc?`<label>Qualifications</label><input name="quals" required placeholder="e.g. MBBS, MD">
  <label>Medical registration number</label><input name="regNo" required><label>Hospital</label><input name="hospital" required>`:''}
 <label>Email</label><input name="email" type="email" required autocomplete="email" value="">
 <label>Password</label><input name="pw" type="password" required minlength="6" autocomplete="${reg?'new-password':'current-password'}">
 <p class="muted" style="margin-top:10px">Sign-in is handled by Supabase Auth. Prototype only, not security-reviewed.${doc&&reg?' Registration numbers are not verified.':''}</p>
 <button class="btn" style="width:100%">${reg?'Create account':'Sign in'}</button>${reg?'':'<button type="button" class="btn ghost" style="width:100%;margin-top:8px" data-act="forgot">Forgot password?</button>'}</form>
 <p style="margin:14px 0 0;text-align:center"><button class="btn ghost" data-act="mode">${reg?'I already have an account':'Create a new account'}</button></p></div></div>`}

function logo(){return `<svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><rect width="28" height="28" rx="8" fill="#0d8f8a"/><path d="M3 15h5l3-7 4 12 3-8 2 3h5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`}

function shell(tabs,body){
 return `<header class="top"><div class="brand">${logo()} Lifeline</div>
 <nav class="tabs">${tabs.map(t=>`<button data-act="tab" data-v="${t[0]}" class="${S.tab===t[0]?'on':''}">${t[1]}</button>`).join('')}</nav>
 <div class="who">${avatar()}<span>${esc(S.user.name)}</span><button data-act="logout">Sign out</button></div></header>
 <main>${body}</main>${S.toast?`<div class="toast" role="status">${esc(S.toast)}</div>`:''}`}

function recCard(r){
 if(r.system)return `<div class="rec"><strong>${esc(r.title)}</strong><p class="muted" style="margin:4px 0 0">${esc(r.note)}</p><div class="meta">${fmtDT(r.createdAt)}</div></div>`;
 return `<div class="rec"><div class="row" style="justify-content:flex-start;gap:8px"><span class="badge">${esc(r.section)}</span><span class="badge ok">${esc(r.type)}</span>${r.addendumTo?'<span class="badge warn">Addendum</span>':''}</div>
 <h3 style="margin-top:8px">${esc(r.title)}</h3><p style="margin:0">${esc(r.note)}</p>
 <div class="meta">${esc(r.author)} · Reg. ${esc(r.reg)} · ${esc(r.hospital)}<br>Added ${fmtDT(r.createdAt)}${r.addendumTo?`<br>Corrects or adds to: ${esc(r.addendumTo)}`:''}</div></div>`}
const timeline=(recs,doc,pid)=>recs.length?`<ul class="tl">${recs.map(r=>`<li class="${r.system?'sys':''}">${recCard(r)}${doc&&!r.system?`<button class="btn ghost" style="margin-top:6px;min-height:36px;padding:4px 12px" data-act="addendum" data-v="${esc(r.title)}">Add addendum</button>`:''}</li>`).join('')}</ul>`:'<div class="empty">No records yet.</div>';

/* ---- Patient ---- */
function patientView(){
 const p=S.user,age=ageOf(p.dob),st=stageOf(age),recs=api.recordsFor(p.id),reqs=api.requestsFor(p.id),pend=reqs.filter(r=>r.status==='pending');
 const tabs=[['home','Overview'],['timeline','Timeline'],['access','Access'+(pend.length?` (${pend.length})`:'')]];
 let b='';
 if(S.tab==='home'){
  const secs=['Pediatrics','Adult','Geriatrics','OBG & Gynae'];
  b=`<h1>Hello, ${esc(p.name.split(' ')[0])}</h1>
  ${pend.length?`<div class="card" style="background:var(--warn);color:var(--warnink)"><strong>${pend.length} doctor access request${pend.length>1?'s':''} waiting.</strong> <button class="btn" style="margin-left:8px" data-act="tab" data-v="access">Review</button></div>`:''}
  <div class="card"><div class="row"><h2 style="margin:0">Your profile</h2>${unverified} </div>
  <div class="kv" style="margin-top:12px"><div><b>Name</b>${esc(p.name)}</div><div><b>Date of birth</b>${fmtDate(p.dob)}</div><div><b>Age</b>${age} years</div><div><b>Sex</b>${esc(p.sex)}</div>
  <div><b>Patient ID</b><span style="font-weight:700;color:var(--blue)">${esc(p.id)}</span></div><div><b>Record started</b>${fmtDate(p.joinedAt)}</div></div>
  <p style="margin:14px 0 0"><b class="muted" style="font-weight:500">Allergies</b><br>${p.allergies?esc(p.allergies):'None entered'} ${p.allergies?(p.allergiesVerifiedBy?`<span class="badge ok">Confirmed by ${esc(p.allergiesVerifiedBy)}</span>`:unverified):''}</p>
  <p class="muted" style="margin:10px 0 0">Information you enter yourself stays unverified until an authorised professional confirms it.</p></div>
  <h2>Life stages</h2><div class="grid" style="grid-template-columns:1fr">${secs.map(s=>{const cur=s===st||(s==='OBG & Gynae'&&obgOn(p));const n=recs.filter(r=>r.section===s).length;
   return `<div class="stage ${cur?'cur':''}"><h3>${s}${cur?'<span class="badge ok">Current</span>':''}</h3><p class="muted" style="margin:0">${SECTIONS[s]}</p><p style="margin:8px 0 0"><b>${n}</b> record${n===1?'':'s'}${!cur&&s==='OBG & Gynae'?' · not applicable':''}</p></div>`}).join('')}</div>`;
